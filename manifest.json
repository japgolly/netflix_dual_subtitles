{
  "manifest_version": 3,
  "name": "Netflix Dual Subtitles",
  "version": "1.3.4",
  "description": "Watch Netflix with two subtitle tracks simultaneously and full Kuromoji.js Japanese Furigana annotations.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.netflix.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Netflix Dual Subtitles",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*"
      ],
      "js": [
        "kuromoji.js",
        "furigana.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js",
        "kuromoji.js",
        "dict/*"
      ],
      "matches": [
        "*://*.netflix.com/*"
      ]
    }
  ]
}
